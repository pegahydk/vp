{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vp",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "d1842660-1024-4583-bf87-b0cb2532fa15","database_name": "vp" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "a62ac7093901478682d140b9f566568d" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
